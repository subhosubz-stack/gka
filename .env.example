DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET="replace_with_long_random_secret"
PORT=3000
FRONTEND_ORIGIN="http://127.0.0.1:3000"

# Vercel Cron (optional) — protect /api/cron/expiry
CRON_SECRET="replace_with_random_cron_secret"

# Public site URL for emails / QR (production)
# PUBLIC_SITE_URL="https://your-app.vercel.app"

# Razorpay (test keys)
RAZORPAY_KEY_ID="rzp_test_xxxx"
RAZORPAY_KEY_SECRET="xxxx"

# Admin (hidden login)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_me"

# Google Sign-In — https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web). Authorized origins: http://localhost:5000 http://127.0.0.1:5500
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"

# Email OTP (optional — without SMTP, dev mode shows codes in API/UI)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@gharkaadda.com"

# SMS OTP via Twilio (optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_FROM=""

# Show OTP in API responses when SMTP/SMS not configured
VERIFICATION_DEV_MODE="true"
VERIFICATION_OTP_TTL_MIN="15"
